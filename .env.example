# ================= Database =================
POSTGRES_USER=video_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=video_platform
DATABASE_URL=postgresql+psycopg://video_user:change_me_strong_password@postgres:5432/video_platform

# ================= Security =================
JWT_SECRET=change_me_random_long_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
CORS_ORIGINS=http://localhost:6688,http://localhost:3000

# Rate limiting (requests per minute per IP on sensitive routes)
RATE_LIMIT_PER_MINUTE=60

# First admin created by seed script
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_FULL_NAME=مدير النظام

# ================= Frontend =================
NEXT_PUBLIC_API_URL=http://localhost:6688/api/v1
NEXT_PUBLIC_SITE_NAME=منصة الفيديو
NEXT_PUBLIC_SITE_URL=http://localhost:6688

# ================= Infra =================
APP_PORT=6688
LOG_LEVEL=INFO
